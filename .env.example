# =====================================================================
# Fluxis AI - environment variable template
# Copy this file to `.env` and fill in the values. Do NOT commit `.env` to Git.
# VITE_* variables are exposed in the browser: never put secrets in them.
# =====================================================================

# --- Database (PostgreSQL development) ---
POSTGRES_DEV_DB=fluxis_dev
POSTGRES_DEV_USER=fluxis_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DEV_PORT=5432

# --- Database (manual tests only; uses the same password as development) ---
POSTGRES_TEST_DB=fluxis_test
POSTGRES_TEST_USER=fluxis_test
POSTGRES_TEST_PORT=5433

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:5173
DEV_SEED_PASSWORD=local-development-only-password
TEST_SEED_PASSWORD=local-test-only-password

# --- Security ---
# Key for encrypting OAuth tokens in the database (32 bytes, base64-encoded).
# Generate with: openssl rand -base64 32
APP_TOKEN_ENCRYPTION_KEY=

# --- Google OAuth / Gmail API (configure on day 15) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback

# --- AI provider (configure on day 22) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Monthly spending limit that the backend must not exceed
AI_MONTHLY_BUDGET_EUR=5

# --- Frontend (Vite) - public values ---
# Vite proxies /api to the backend in development; set the API base URL on deploy.
VITE_API_URL=/api
