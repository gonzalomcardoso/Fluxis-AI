# =====================================================================
# Fluxis AI - environment variable template
# Copy this file to `.env` and fill in the values. Do NOT commit `.env` to Git.
# VITE_* variables are exposed in the browser: never put secrets in them.
# =====================================================================

# --- Database (PostgreSQL) ---
POSTGRES_DB=fluxis
POSTGRES_USER=fluxis
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:5173

# --- Security ---
# Key for encrypting OAuth tokens in the database (32 bytes, base64-encoded).
# Generate with: openssl rand -base64 32
APP_TOKEN_ENCRYPTION_KEY=

# --- Google OAuth / Gmail API (configure on day 15) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback

# --- AI provider (configure on day 22) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Monthly spending limit that the backend must not exceed
AI_MONTHLY_BUDGET_EUR=5

# --- Frontend (Vite) - public values ---
VITE_API_BASE_URL=http://localhost:8080
